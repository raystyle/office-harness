# office-harness 环境变量样例,唯一权威;.env 不进库,已设环境变量恒优先
# OFFICE_HARNESS_TIMEOUT=600
# OFFICECLI_BIN=D:\ohmyenv\officecli\officecli.exe
# READER_BIN=D:\ohmyenv\reader\reader.exe
# TECTONIC_BIN=D:\ohmyenv\tectonic\tectonic.exe
# WAVO_BIN=D:\ohmyenv\cargo\bin\wavo.exe
# PANDOC_BIN=C:\Program Files\pandoc\pandoc.exe
# AGENT_SVGTOOLS_BIN=D:\ohmyenv\agent-svgtools\agent-svgtools.EXE
# OXVG_BIN=D:\ohmyenv\oxvg\oxvg.EXE
# kami 渲染内核的 GTK(pango) 原生库目录;默认发现梯:此项 -> C:\Program Files\qemu -> C:\GTK3-Runtime\bin
# KAMI_GTK_BIN=C:\Program Files\qemu
